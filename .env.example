# ══════════════════════════════════════════════════════════════════════════════
#  CloudVerse — Environment Configuration
#  Copy this file to .env and fill in your values. Never commit .env.
# ══════════════════════════════════════════════════════════════════════════════

# ── Logging ───────────────────────────────────────────────────────────────────
# Verbosity level for all bots. Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Security & Encryption ─────────────────────────────────────────────────────
# Fernet key (AES-128) shared by all bots for encrypting credentials at rest.
# Generate BOTH values with: python tests/generate_encryption_keys.py
ENCRYPTION_KEY=<your-encryption-key-here>
ENCRYPTION_SALT=<your-encryption-salt-here>

# HMAC secret for signing single-use deep-link tokens (Support bot).
# Must be a long, high-entropy string. Min recommended: 32 chars.

# General-purpose secure token (used by middleware / HMAC signing)
SECURE_TOKEN=<your-secure-token-here>

# ── Drive Bot ─────────────────────────────────────────────────────────────────
# Telegram Bot API token — obtain from @BotFather → /newbot
BOT_TOKEN=<your-drive-bot-token-here>

# Telegram numeric user ID of the Drive bot's super-admin
SUPER_ADMIN_ID=<your-admin-id-here>

# Google Drive OAuth 2.0 — obtain from Google Cloud Console → APIs & Services → Credentials
# Create an "OAuth 2.0 Client ID" of type "Desktop app", then copy the values below.
GDRIVE_CLIENT_ID=<your-gdrive-client-id-here>
GDRIVE_CLIENT_SECRET=<your-gdrive-client-secret-here>

# The two URIs below are Google's standard endpoints — only override if you have a custom setup.
GDRIVE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GDRIVE_TOKEN_URI=https://oauth2.googleapis.com/token

# ── Mega Bot (scaffolded — core upload flow only) ─────────────────────────────
# Telegram Bot API token for the Mega bot
MEGA_BOT_TOKEN=<your-mega-bot-token-here>

# Telegram numeric user ID of the Mega bot's super-admin
MEGA_SUPER_ADMIN_ID=<your-admin-id-here>

# ── rclone Bot (scaffolded — core upload flow only) ───────────────────────────
# Telegram Bot API token for the rclone bot
RCLONE_BOT_TOKEN=<your-rclone-bot-token-here>

# Telegram numeric user ID of the rclone bot's super-admin
RCLONE_SUPER_ADMIN_ID=<your-admin-id-here>

# Absolute path to the rclone binary. Default assumes rclone is on $PATH.
RCLONE_PATH=rclone

# Absolute path to a custom rclone config file.
# Leave empty to use rclone's default location (~/.config/rclone/rclone.conf).
RCLONE_CONFIG_PATH=

# ── Support Bot ───────────────────────────────────────────────────────────────
# Telegram Bot API token for the Support bot
SUPPORT_BOT_TOKEN=<your-support-bot-token-here>

# Public username of the Support bot (no @ prefix). Default: CloudVerseSupportBot
SUPPORT_BOT_USERNAME=<CloudVerseSupportBot>

# Admin group — the backend Telegram group where topic-based admin events post
TEAM_CLOUDVERSE_GROUP_CHAT_ID=<your-group-chat-id-here>

# Telegram numeric group ID of the Support group where tickets are managed
CLOUDVERSE_SUPPORT_GROUP_ID=<your-support-group-chat-id-here>

# Topic IDs inside the admin group (each is a unique Forum thread integer ID)
ACCESS_TOPIC_ID=<topic-id-here>
FLAGS_TOPIC_ID=<topic-id-here>
REPORTS_TOPIC_ID=<topic-id-here>
BROADCASTS_TOPIC_ID=<topic-id-here>
MANAGEMENT_TOPIC_ID=<topic-id-here>
ALERTS_TOPIC_ID=<topic-id-here>
BUGS_TOPIC_ID=<topic-id-here>
LOGS_TOPIC_ID=<topic-id-here>